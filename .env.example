# Copy to .env and fill in. With no API key the assistant runs in offline demo mode
# (keyword rules + templates).

# --- LLM (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used only if GEMINI_API_KEY is empty:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- IMAP, only for: python -m assistant.main --source imap ---
# The mailbox is opened READ-ONLY; messages are not marked as read, moved or deleted.
# Use an app password where the provider supports it.
IMAP_HOST=imap.example.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_LIMIT=20

# --- IMAP APPEND of APPROVED drafts into the Drafts folder (never sends) ---
# Used only with --imap-append (python -m assistant.review --imap-append
# or python -m assistant.imap_drafts --imap-append). Gmail: [Gmail]/Drafts
IMAP_DRAFTS_FOLDER=Drafts
IMAP_PORT=993
